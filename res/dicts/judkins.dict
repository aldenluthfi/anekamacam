= protocols =
uci
usi

= uci fen =
T -> +P
V -> +N
W -> +S
D -> +R
H -> +B
t -> +p
v -> +n
^([^ ]*)w -> ${1}+s
^([^ ]*)w -> ${1}+s
d -> +r
h -> +b
^([^ ]+) ([wb]) -/- ([0-9]+)$ -> ${1}[] ${2} - - 0 ${3}
^([^ ]+) ([wb]) -/([^ ]+) ([0-9]+)$ -> ${1}[${3}] ${2} - - 0 ${4}
^([^ ]+) ([wb]) ([^ ]+)/- ([0-9]+)$ -> ${1}[${3}] ${2} - - 0 ${4}
^([^ ]+) ([wb]) ([^ ]+)/([^ ]+) ([0-9]+)$ -> ${1}[${3}${4}] ${2} - - 0 ${5}

${1} ${2} -/- ${3} <- ^([^ ]+)\[\] ([wb]) [^ ]+ [^ ]+ [0-9]+ ([0-9]+)$
${1} ${3} ${2}/- ${4} <- ^([^ ]+)\[([A-Z]+)\] ([wb]) [^ ]+ [^ ]+ [0-9]+ ([0-9]+)$
${1} ${3} -/${2} ${4} <- ^([^ ]+)\[([a-z]+)\] ([wb]) [^ ]+ [^ ]+ [0-9]+ ([0-9]+)$
${1} ${4} ${2}/${3} ${5} <- ^([^ ]+)\[([A-Z]+)([a-z]+)\] ([wb]) [^ ]+ [^ ]+ [0-9]+ ([0-9]+)$
T <- \+P
V <- \+N
W <- \+S
D <- \+R
H <- \+B
t <- \+p
v <- \+n
w <- \+s
d <- \+r
h <- \+b

= uci moves =
=T|=V|=W|=D|=H|=t|=v|=w|=d|=h -> +
p@ -> P@
n@ -> N@
s@ -> S@
g@ -> G@
r@ -> R@
b@ -> B@
\* ->
: ->

= usi fen =
T -> +P
V -> +N
W -> +S
D -> +R
H -> +B
t -> +p
v -> +n
^([^ ]*)w -> ${1}+s
^([^ ]*)w -> ${1}+s
d -> +r
h -> +b
^([^ ]+) ([wb]) -/- ([0-9]+)$ -> $1 $2 / $3
^([^ ]+) ([wb]) -/([^ ]+) ([0-9]+)$ -> $1 $2 /$3 $4
^([^ ]+) ([wb]) ([^ ]+)/- ([0-9]+)$ -> $1 $2 $3/ $4
^([^ ]+) w (P*)(N*)(S*)(G*)(R*)(B*)/(p*)(n*)(s*)(g*)(r*)(b*) ([0-9]+)$ -> ${1} b ${6}${7}${5}${4}${3}${2}${12}${13}${11}${10}${9}${8} ${14}
^([^ ]+) b (P*)(N*)(S*)(G*)(R*)(B*)/(p*)(n*)(s*)(g*)(r*)(b*) ([0-9]+)$ -> ${1} w ${6}${7}${5}${4}${3}${2}${12}${13}${11}${10}${9}${8} ${14}
^([^ ]+ [bw] [^ ]*)P{2} -> ${1}2P
^([^ ]+ [bw] [^ ]*)N{2} -> ${1}2N
^([^ ]+ [bw] [^ ]*)S{2} -> ${1}2S
^([^ ]+ [bw] [^ ]*)G{2} -> ${1}2G
^([^ ]+ [bw] [^ ]*)R{2} -> ${1}2R
^([^ ]+ [bw] [^ ]*)B{2} -> ${1}2B
^([^ ]+ [bw] [^ ]*)p{2} -> ${1}2p
^([^ ]+ [bw] [^ ]*)n{2} -> ${1}2n
^([^ ]+ [bw] [^ ]*)s{2} -> ${1}2s
^([^ ]+ [bw] [^ ]*)g{2} -> ${1}2g
^([^ ]+ [bw] [^ ]*)r{2} -> ${1}2r
^([^ ]+ [bw] [^ ]*)b{2} -> ${1}2b
^([^ ]+ [bw])  ([0-9]+)$ -> $1 - $2

${1} -/${2} ${3} ${4} <- ^([^ ]+ [wb]) /([^ ]+) ([0-9]+) ([0-9]+)$
${1} ${2}/- ${3} ${4} <- ^([^ ]+ [wb]) ([^ ]+)/ ([0-9]+) ([0-9]+)$
${1} w ${7}${6}${5}${4}${2}${3}/${13}${12}${11}${10}${8}${9} 0 ${14} <- ^([^ ]+) b (R*)(B*)(G*)(S*)(N*)(P*)(r*)(b*)(g*)(s*)(n*)(p*) ([0-9]+)$
${1} b ${7}${6}${5}${4}${2}${3}/${13}${12}${11}${10}${8}${9} 0 ${14} <- ^([^ ]+) w (R*)(B*)(G*)(S*)(N*)(P*)(r*)(b*)(g*)(s*)(n*)(p*) ([0-9]+)$
${1} w -/- 0 ${2} <- ^([^ ]+) b - ([0-9]+)$
${1} b -/- 0 ${2} <- ^([^ ]+) w - ([0-9]+)$
${1}PP <- ^([^ ]+ [bw] [^ ]*)2P
${1}NN <- ^([^ ]+ [bw] [^ ]*)2N
${1}SS <- ^([^ ]+ [bw] [^ ]*)2S
${1}GG <- ^([^ ]+ [bw] [^ ]*)2G
${1}RR <- ^([^ ]+ [bw] [^ ]*)2R
${1}BB <- ^([^ ]+ [bw] [^ ]*)2B
${1}pp <- ^([^ ]+ [bw] [^ ]*)2p
${1}nn <- ^([^ ]+ [bw] [^ ]*)2n
${1}ss <- ^([^ ]+ [bw] [^ ]*)2s
${1}gg <- ^([^ ]+ [bw] [^ ]*)2g
${1}rr <- ^([^ ]+ [bw] [^ ]*)2r
${1}bb <- ^([^ ]+ [bw] [^ ]*)2b
T <- \+P
V <- \+N
W <- \+S
D <- \+R
H <- \+B
t <- \+p
v <- \+n
w <- \+s
d <- \+r
h <- \+b

= usi moves =
=T|=V|=W|=D|=H|=t|=v|=w|=d|=h -> +
p@ -> P@
n@ -> N@
s@ -> S@
g@ -> G@
r@ -> R@
b@ -> B@
