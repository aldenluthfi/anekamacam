= protocols =
uci

// Janggi has no castling or en passant, and it keeps no halfmove clock, so
// the internal CFEN is "board stm hand fullmove" with the setup hand written
// "white/black". The UCI form appends the hand to the board in brackets, as
// the drop variants do, and supplies the empty castling, en passant and
// halfmove fields a UCI GUI expects to find.
= uci fen =
^([^ ]+) ([wb]) -/- ([0-9]+)$ -> ${1}[] ${2} - - 0 ${3}
^([^ ]+) ([wb]) -/([^ ]+) ([0-9]+)$ -> ${1}[${3}] ${2} - - 0 ${4}
^([^ ]+) ([wb]) ([^ ]+)/- ([0-9]+)$ -> ${1}[${3}] ${2} - - 0 ${4}
^([^ ]+) ([wb]) ([^ ]+)/([^ ]+) ([0-9]+)$ -> ${1}[${3}${4}] ${2} - - 0 ${5}
${1} ${2} -/- ${3} <- ^([^ ]+)\[\] ([wb]) [^ ]+ [^ ]+ [0-9]+ ([0-9]+)$
${1} ${3} ${2}/- ${4} <- ^([^ ]+)\[([A-Z]+)\] ([wb]) [^ ]+ [^ ]+ [0-9]+ ([0-9]+)$
${1} ${3} -/${2} ${4} <- ^([^ ]+)\[([a-z]+)\] ([wb]) [^ ]+ [^ ]+ [0-9]+ ([0-9]+)$
${1} ${4} ${2}/${3} ${5} <- ^([^ ]+)\[([A-Z]+)([a-z]+)\] ([wb]) [^ ]+ [^ ]+ [0-9]+ ([0-9]+)$

= uci moves =
= ->
\* ->
: ->
