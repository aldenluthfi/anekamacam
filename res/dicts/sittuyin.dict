= protocols =
uci

= uci fen =
^((?:[^ ]*k)[^ ]*K[^ ]*) ([wb]) [^ ]+ ([0-9]+) ([0-9]+)$ -> ${1}[] ${2} - - ${3} ${4}
^((?:[^ ]*K)[^ ]*k[^ ]*) ([wb]) [^ ]+ ([0-9]+) ([0-9]+)$ -> ${1}[] ${2} - - ${3} ${4}
^([^ ]+) ([wb]) -/- ([0-9]+) ([0-9]+)$ -> ${1}[] ${2} - - ${3} ${4}
^([^ ]+) ([wb]) -/([^ ]+) ([0-9]+) ([0-9]+)$ -> ${1}[${3}] ${2} - - ${4} ${5}
^([^ ]+) ([wb]) ([^ ]+)/- ([0-9]+) ([0-9]+)$ -> ${1}[${3}] ${2} - - ${4} ${5}
^([^ ]+) ([wb]) ([^ ]+)/([^ ]+) ([0-9]+) ([0-9]+)$ -> ${1}[${3}${4}] ${2} - - ${5} ${6}

F <- ~F
f <- ~f
${1}${2}/- ${3} <- ^((?:[^ ]*F)[^ ]* [wb] )([^/]+)/~f ([0-9]+ [0-9]+)$
${1}-/${2} <- ^((?:[^ ]*f)[^ ]* [wb] )~F/(~f [0-9]+ [0-9]+)$
${1} ${3} ${2}/- ${4} ${5} <- ^([^ ]+)\[([A-Z]+)\] ([wb]) [^ ]+ [^ ]+ ([0-9]+) ([0-9]+)$
${1} ${3} -/${2} ${4} ${5} <- ^([^ ]+)\[([a-z]+)\] ([wb]) [^ ]+ [^ ]+ ([0-9]+) ([0-9]+)$
${1} ${4} ${2}/${3} ${5} ${6} <- ^([^ ]+)\[([A-Z]+)([a-z]+)\] ([wb]) [^ ]+ [^ ]+ ([0-9]+) ([0-9]+)$
${1} ${2} ~F/~f ${3} ${4} <- ^([^ ]+)\[\] ([wb]) [^ ]+ [^ ]+ ([0-9]+) ([0-9]+)$

= uci moves =
=F -> f
= ->
\* ->
: ->
