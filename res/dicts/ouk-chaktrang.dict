= protocols =
uci

= uci fen =
^(rnsmksnr/8/pppppppp/8/8/PPPPPPPP/8/RNSKMSNR) ([wb])$ -> $1 $2 DEde - 0 1
^([^ ]+) ([wb])$ -> $1 $2 - - 0 1
^(rnsmksnr/8/pppppppp/8/8/PPPPPPPP/8/RNSKMSNR) ([wb]) ([0-9]+) ([0-9]+)$ -> ${1} ${2} DEde - ${3} ${4}
^([^ ]+) ([wb]) ([0-9]+) ([0-9]+)$ -> ${1} ${2} - - ${3} ${4}
${1} ${2} ${3} ${4} <- ^([^ ]+) ([wb]) [^ ]+ [^ ]+ ([0-9]+) ([0-9]+)$

= uci moves =
=M -> m
= ->
\* ->
: ->
