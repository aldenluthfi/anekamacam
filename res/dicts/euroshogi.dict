^([^ ]+) ([wb]) ([^ ]+)/- ([0-9]+)$ -> ${1}[${3}] ${2} - - 0 ${4}
^([^ ]+) ([wb]) ([^ ]+)/([^ ]+) ([0-9]+)$ -> ${1}[${3}${4}] ${2} - - 0 ${5}

${1} ${2} -/- ${3} <- ^([^ ]+)\[\] ([wb]) [^ ]+ [^ ]+ [0-9]+ ([0-9]+)$
${1} ${3} ${2}/- ${4} <- ^([^ ]+)\[([A-Z]+)\] ([wb]) [^ ]+ [^ ]+ [0-9]+ ([0-9]+)$
${1} ${3} -/${2} ${4} <- ^([^ ]+)\[([a-z]+)\] ([wb]) [^ ]+ [^ ]+ [0-9]+ ([0-9]+)$
${1} ${4} ${2}/${3} ${5} <- ^([^ ]+)\[([A-Z]+)([a-z]+)\] ([wb]) [^ ]+ [^ ]+ [0-9]+ ([0-9]+)$
